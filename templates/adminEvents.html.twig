{% extends '/base.html.twig' %}

{% block title %}{{ parent() }} | Gestion des événements{% endblock %}

{% block body %}
    <div class="container py-5">

        <div class="mb-4">
            <h1 class="fw-bold mb-2">Gestion des événements</h1>
            <p class="text-muted mb-0">
                Retrouvez tous les événements et leurs organisateurs.
            </p>
        </div>

        {% if events is empty %}
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
                <h4 class="fw-bold mb-3">Aucun événement</h4>
                <p class="text-muted mb-0">
                    Aucun événement n'a été créé pour le moment.
                </p>
            </div>
        {% else %}
            <div class="row g-4">
                {% for event in events %}
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">

                            <span class="badge bg-light text-primary border mb-3 align-self-start">
                                {{ event.startAt|date('d/m/Y') }}
                            </span>

                            <h4 class="fw-bold mb-3">
                                {{ event.title }}
                            </h4>

                            <p class="text-muted mb-2">
                                Organisateur :
                                <span class="fw-bold text-dark">
                                    {{ event.organizer.username }}
                                </span>
                            </p>

                            <p class="text-muted mb-2">
                                Début à {{ event.startAt|date('H:i') }}
                            </p>

                            <p class="text-muted mb-3">
                                Fin à {{ event.endAt|date('d/m/Y H:i') }}
                            </p>

                            <p class="mb-3">
                                <span class="fw-bold">Places :</span>
                                {{ event.capacity }}
                            </p>

                            <p class="mb-3">
                                <span class="fw-bold">Statut :</span>
                                <span class="badge bg-light text-primary border">
                                    {{ event.status.value }}
                                </span>
                            </p>

                            <div class="mt-auto">
                                <a href="{{ path('show-event', {id: event.id}) }}"
                                   class="btn btn-outline-primary rounded-pill px-4">
                                    Voir l'événement
                                    <span class="ms-2">→</span>
                                </a>
                            </div>

                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
{% endblock %}
